<?xml version="1.0"?>
<package format="3">
  <name>explorer_bringup</name>
  <version>2.0.0</version>
  <description>The bringup package for the exploration bot</description>

  <maintainer email="gonzalezpobletefelipe@gmail.com">Felipe Gonzalez</maintainer>
  <author email="gonzalezpobletefelipe@gmail.com">Felipe Gonzalez</author>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <!-- For tests -->
  <test_depend>ament_lint_auto</test_depend>
